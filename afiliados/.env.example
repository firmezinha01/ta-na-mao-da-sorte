# Firebase Authentication & Firestore Configuration
# Preencha com as credenciais do seu projeto Firebase Console:
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=tanamaodasorte-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tanamaodasorte-app
VITE_FIREBASE_STORAGE_BUCKET=tanamaodasorte-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Nota: Caso estas variáveis não sejam preenchidas, a aplicação opera
# automaticamente em modo de demonstração local com persistência no navegador!
