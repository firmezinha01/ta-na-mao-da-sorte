rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAffiliateOwner(affiliateId) {
      return isAuthenticated() && request.auth.uid == affiliateId;
    }

    // Affiliates Collection
    match /affiliates/{affiliateId} {
      // Affiliates can read their own profile; Admins can read all
      allow read: if isAffiliateOwner(affiliateId) || isAdmin();
      
      // Registration allowed if user is authenticated and writing their own record
      allow create: if isAffiliateOwner(affiliateId) && 
        request.resource.data.status == 'pendente' &&
        request.resource.data.balanceAvailable == 0 &&
        request.resource.data.balancePending == 0 &&
        request.resource.data.balancePaid == 0;
      
      // Updates: Affiliates can update contact & pix info only; cannot tamper with balances or status
      allow update: if (isAffiliateOwner(affiliateId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'balanceAvailable', 'balancePending', 'balancePaid', 'status', 'commissionRate', 'exclusiveCode'
        ])) || isAdmin();
      
      allow delete: if isAdmin();
    }

    // Links Collection
    match /affiliateLinks/{linkId} {
      allow read: if resource.data.affiliateId == request.auth.uid || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.affiliateId == request.auth.uid;
      allow update: if (resource.data.affiliateId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['clicksCount', 'conversionsCount', 'revenueGenerated'])) || isAdmin();
      allow delete: if resource.data.affiliateId == request.auth.uid || isAdmin();
    }

    // Clicks Collection (public tracking entry with sanitization)
    match /clicks/{clickId} {
      allow create: if request.resource.data.affiliateCode is string &&
                       request.resource.data.affiliateCode.size() > 0 &&
                       request.resource.data.affiliateCode.size() < 30;
      allow read, update, delete: if isAdmin();
    }

    // Conversions Collection
    match /conversions/{conversionId} {
      allow read: if (isAuthenticated() && resource.data.affiliateId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Commissions Collection
    match /commissions/{commissionId} {
      allow read: if (isAuthenticated() && resource.data.affiliateId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if (isAuthenticated() && resource.data.affiliateId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && 
        request.resource.data.affiliateId == request.auth.uid &&
        request.resource.data.status == 'solicitado';
      allow update, delete: if isAdmin();
    }

    // Promotional Materials
    match /promotionalMaterials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if isAdmin();
    }

    // Settings
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
